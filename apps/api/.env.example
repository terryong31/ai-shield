# Copy to .env. Every value is optional; the gateway degrades rather than failing.
# Full reference: docs/reference/configuration.md

# Groq: Llama Guard moderation, the Analyst/Warden debate, and chat fallback
GROQ_API_KEY=
# GROQ_GUARD_MODEL=llama-guard-3-8b
# GROQ_DEBATE_MODEL=llama-3.3-70b-versatile
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Google Gemini: primary model for the demo assistant's answers
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Audit log: Supabase when BOTH values are set, otherwise SQLite at SQLITE_PATH.
# Local stack: `mise run db:start`, then paste the output of `mise run db:env`.
# Use a server-side key (service_role / secret), never the anon key.
SUPABASE_URL=
SUPABASE_KEY=
# SQLITE_PATH=var/shield.db

# Demo stand-in for RBAC. Unset = nobody can obtain GRANTED clearance.
# Pick a long random value, e.g. `openssl rand -hex 16`.
SECURE_PASSPHRASE=

# Where reviewer labels are appended
# FEEDBACK_PATH=var/feedback.csv

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://[::1]:3000,http://[::]:3000

# LOG_LEVEL=INFO
