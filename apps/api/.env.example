# Optional local override file. By default, `mise run dev` / `mise run api:dev`
# injects secrets from Infisical (`dev` env, `/api` path) and local Supabase
# credentials from `supabase status -o json` via `scripts/local_env.py`.
# Full reference: docs/reference/configuration.md

# development locally (Swagger UI on; rate limits and BotID off). Unset means production,
# which is what the Vercel deployment uses.
APP_ENV=development

# Groq: Llama Guard moderation, the Analyst/Warden debate, and chat fallback
GROQ_API_KEY=
# GROQ_GUARD_MODEL=llama-guard-3-8b
# GROQ_DEBATE_MODEL=llama-3.3-70b-versatile
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GAME_MODEL_BUDGET=openai/gpt-oss-20b

# Google Gemini: primary model for the demo assistant's answers
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Storage & identity: Supabase (required — start local stack with `mise run db:start`).
# `mise run api:dev` supplies local Supabase env automatically if SUPABASE_URL is unset.
# Use a server-side key (service_role / secret), never the anon key.
SUPABASE_URL=
SUPABASE_KEY=

# Optional Redis URL for sub-millisecond leaderboard caching (spec 0044); required in APP_ENV=production.
# REDIS_URL=redis://localhost:6379/0
# HMAC key for temporary server-held trained ML models (spec 0045); required in production for /game/train.
# MODEL_SIGNING_KEY=

# Public origin of the web client (required and non-localhost in APP_ENV=production, spec 0047).
# Confirmation and recovery links point to <WEB_BASE_URL>/auth/confirmed and /auth/reset-password.
WEB_BASE_URL=http://localhost:3000

# Reverse proxy / BotID trust settings (required when running behind the Nuxt proxy in production)
# TRUSTED_CLIENT_IP_HEADER=x-shield-client-ip
# TRUSTED_PROXY_SECRET=

# Where reviewer labels are appended
# FEEDBACK_PATH=var/feedback.csv

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://[::1]:3000,http://[::]:3000

# LOG_LEVEL=INFO

TYPESAFE_API_KEY=