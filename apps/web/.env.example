# Gateway origin (apps/api) as reached from the web server; the browser only
# calls same-origin /api/v1, which the server proxies here (spec 0041).
NUXT_API_PROXY_TARGET=http://localhost:8000
# Shared secret with gateway TRUSTED_PROXY_SECRET & header for client IP (spec 0043).
# NUXT_API_PROXY_SECRET=
NUXT_CLIENT_IP_HEADER=x-vercel-forwarded-for
# Public origin of this web app for canonical, Open Graph, and Twitter Card URLs
NUXT_PUBLIC_SITE_URL=http://localhost:3000
