{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mise run *)",
      "Bash(mise tasks*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy*)",
      "Bash(uv run shield-engine *)",
      "Bash(uv run shield-api-export-openapi*)",
      "Bash(uv run python scripts/*)",
      "Bash(uv sync*)",
      "Bash(bun run test*)",
      "Bash(bun run lint*)",
      "Bash(bun run typecheck*)",
      "Bash(bun run build*)",
      "Bash(bun run contract*)",
      "Bash(bun run --cwd apps/web *)",
      "Bash(bunx vitest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(python3 scripts/sdd.py *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(apps/web/app/types/api.gen.ts)",
      "Edit(.sdd/**)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(uv add*)",
      "Bash(bun add*)",
      "Edit(.github/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Formatting edited file"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/sdd.py hook pre-tool",
            "timeout": 10,
            "statusMessage": "SDD guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/sdd.py hook stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/sdd.py hook session-start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
